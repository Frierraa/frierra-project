generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

enum OrderStatus {
  NEW
  PAID
  COOKING
  DELIVERING
  DONE
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentProvider {
  YOOKASSA
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String?
  name              String?
  phone             String?  @unique
  role              UserRole @default(USER)
  emailVerifiedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders            Order[]
  sessions          AuthSession[]
  adminSessions     AdminSession[]
}

model AuthSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhoneOtp {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
}

model TelegramAccount {
  id        String   @id @default(cuid())
  phone     String   @unique
  chatId    String   @unique
  username  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramLinkRequest {
  id         String    @id @default(cuid())
  phone      String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  description   String
  imageUrl      String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants      ProductVariant[]
  comboIn       VariantComboItem[]
}

model ProductVariant {
  id            String                 @id @default(cuid())
  title         String
  sku           String?                @unique
  weightGram    Int?
  priceRub      Int
  oldPriceRub   Int?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  productId     String
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredients   ProductVariantIngredient[]
  orderItems    OrderItem[]
  comboItems    VariantComboItem[]
}

model VariantComboItem {
  id         String         @id @default(cuid())
  qty        Int            @default(1)
  createdAt  DateTime       @default(now())

  variantId  String
  productId  String

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([variantId, productId])
}

model Ingredient {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  priceDeltaRub Int                    @default(0)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  variants      ProductVariantIngredient[]
}

model ProductVariantIngredient {
  id            String         @id @default(cuid())
  isRemovable   Boolean        @default(true)
  extraPriceRub Int            @default(0)

  variantId     String
  ingredientId  String

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient    Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([variantId, ingredientId])
}

model Order {
  id                 String         @id @default(cuid())
  number             Int            @default(0)
  status             OrderStatus    @default(NEW)
  deliveryType       DeliveryType
  customerName       String
  customerPhone      String
  deliveryAddress    String?
  comment            String?
  itemsTotalRub      Int
  deliveryFeeRub     Int            @default(0)
  totalRub           Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  payment            Payment?
}

model OrderItem {
  id                 String         @id @default(cuid())
  titleSnapshot      String
  variantSnapshot    String
  priceRubSnapshot   Int
  qty                Int
  lineTotalRub       Int

  orderId            String
  variantId          String?

  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Payment {
  id                 String          @id @default(cuid())
  provider           PaymentProvider
  status             PaymentStatus   @default(PENDING)
  externalPaymentId  String?         @unique
  amountRub          Int
  payloadJson        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  orderId            String          @unique
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

